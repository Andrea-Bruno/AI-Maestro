<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Maestro_AI</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <UserSecretsId>619b5325-302a-4b31-a137-2817a733a16e</UserSecretsId>
    <!-- Release gate (same scheme as AgentBridge): IsPrerelease=true while iterating →
         version gets "-prerelease" and release.yml skips. Set IsPrerelease=false only when
         the test cycles proved the version works → pushing main triggers release.yml, which
         builds the platform archives and creates the GitHub release (tag v1.yy.MM.dd).
         Date-based auto version: 1.yy.MM.dd (e.g. 1.26.08.30). -->
    <IsPrerelease>false</IsPrerelease>
    <Version Condition="'$(IsPrerelease)' == 'true'">$([System.DateTime]::Now.ToString("1.yy.MM.dd"))-prerelease</Version>
    <Version Condition="'$(IsPrerelease)' != 'true'">$([System.DateTime]::Now.ToString("1.yy.MM.dd"))</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="S7netplus" Version="0.20.0" />
    <ProjectReference Include="..\..\UISupportBlazor\UISupportBlazor.csproj" Condition="Exists('..\..\UISupportBlazor\UISupportBlazor.csproj')" />
    <PackageReference Include="UISupportBlazor" Version="1.*" Condition="!Exists('..\..\UISupportBlazor\UISupportBlazor.csproj')" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Device.Gpio" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="LICENSE.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="docs/**/*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EncryptedMessaging\EncryptedMessaging\EncryptedMessaging.csproj" />
  </ItemGroup>

</Project>
