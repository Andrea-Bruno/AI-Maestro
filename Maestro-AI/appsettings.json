{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // On a LAN appliance without certificates (e.g. Orange Pi) set this to false to serve
  // plain HTTP; the installer writes the deployed appsettings accordingly. Default true.
  "ForceHttps": true,

  // ── Hardware Configuration ──
  // Set Enabled:true + MachineType:"Simulated" for testing without physical devices.
  // See docs/en/09-hardware.md for 88 supported machines across 8 protocols.
  "Hardware": {
    "Enabled": false,
    "MachineType": "Simulated",
    "SerialPort": "COM1",
    "BaudRate": 19200,
    "TcpHost": "192.168.1.100",
    "TcpPort": 502,
    "UnitId": 1,
    "BleDeviceName": "",
    "MqttBroker": "localhost",
    "MqttTopic": "roaster/data",
    "WsUrl": "ws://localhost:8080/ws",
    "SampleIntervalMs": 2000,
    "GpioOutputPins": [17, 18, 22, 23, 24, 25, 27],
    "GpioInputPins": [4],
    "GpioHeaterPin": 17,
    "GpioFanPin": 18,
    "GpioTempPin": 4,
    "GpioTempType": "ds18b20",
    "GpioTempAddress": "",

    // Orange Pi 5 Pro pin map (BCM pin -> "chip:line"). Uncomment ONLY on an Orange Pi
    // 5 Pro: there the BCM numbers do not match the gpiochip lines and the driver refuses
    // to drive GPIO without this map (safety). Raspberry Pi needs no map (BCM = chip0 raw
    // lines). Table verified with `gpio readall` (WiringOP) — see docs/en/09-hardware.md.
    // "GpioPinMap": {
    //   "17": "4:10", "18": "1:7",  "22": "1:14", "23": "1:1",
    //   "24": "1:0",  "25": "1:8",  "27": "4:11", "4":  "1:15"
    // },
  },

  // ── AI / Advanced Feature Toggles ──
  // When a feature is disabled, the corresponding UI elements are hidden
  // and server-side APIs return "feature disabled".
  "AiFeatures": {
    "Enabled": true,
    "ProfileGeneration": true,
    "EnergyAnalysis": true,
    "CertificateGeneration": true,
    "SupplyChain": true,
    "Cupping": true,
    "CrackDetection": true,
    "PredictiveTrainer": true,
    "CloudMessaging": true,
    "MachineIdentity": true,
    "Blockchain": true,
    "Spectroscopy": true,
    "HybridHeating": true,
    "ExtraSensors": true,
    "ProfileSigning": true,
    "ImportExport": true,
    "ExternalInstruments": true
  },

  // ── External Laboratory / Workshop Instruments ──
  // Connect via USB (serial, HID). When enabled, they appear in the Tools tab.
  // In simulation mode (Enabled:true) all instruments generate random values.
  // See docs/en/33-instruments.md for supported models and wiring.
  "Instruments": {
    "Enabled": false,
    "GasManometer": { "Enabled": true, "Port": "COM5", "BaudRate": 9600, "MinPressureKpa": 0, "MaxPressureKpa": 10, "AlarmLowKpa": 0.5, "AlarmHighKpa": 8.0 },
    "AirflowMeter": { "Enabled": true, "Port": "COM6", "BaudRate": 9600, "MinFlowMs": 0, "MaxFlowMs": 20 },
    "Variac": { "Enabled": true, "Port": "COM7", "BaudRate": 9600, "MinVoltage": 0, "MaxVoltage": 250, "DefaultSetpoint": 200 },
    "DrumRpm": { "Enabled": true, "Port": "COM8", "BaudRate": 9600, "MinRpm": 0, "MaxRpm": 100 },
    "Hygrometer": { "Enabled": true, "Port": "COM9", "BaudRate": 9600 },
    "CoDetector": { "Enabled": true, "Port": "COM10", "BaudRate": 9600, "AlarmThresholdPpm": 50, "CriticalThresholdPpm": 200 },
    "MoistureTester": { "Enabled": true, "Port": "COM11", "BaudRate": 9600 },
    "Barometer": { "Enabled": true, "Port": "COM12", "BaudRate": 9600, "MinPressureHpa": 950, "MaxPressureHpa": 1050 }
  }
}
